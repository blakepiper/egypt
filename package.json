{
  "name": "living-archive-egypt",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run content:build && vite",
    "content:build": "tsx scripts/content/build-content.ts",
    "content:check": "tsx scripts/content/check-content.ts",
    "media:build": "tsx scripts/media/build-media.ts",
    "media:check": "tsx scripts/media/check-rights.ts",
    "review:check": "tsx scripts/content/check-copy-review.ts",
    "build": "npm run content:build && npm run typecheck && vite build && tsx scripts/content/build-routes.ts && npm run artifact:check",
    "artifact:check": "tsx scripts/content/check-artifact.ts",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test:visual": "playwright test tests/visual.spec.ts",
    "check:contrast": "node scripts/check-contrast.mjs",
    "check": "npm run content:check && npm run media:check && npm run review:check && npm run typecheck && npm run check:contrast && npm run test:unit && npm run build && npm run test:e2e"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.62.1",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.4.0",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "graphology": "0.26.0",
    "graphology-communities-louvain": "2.0.2",
    "graphology-metrics": "2.4.1",
    "graphology-shortest-path": "2.1.0",
    "js-yaml": "^5.4.1",
    "marked": "^18.0.11",
    "sharp": "^0.35.4",
    "tsx": "^4.23.13",
    "typescript": "5.7.2",
    "vite": "6.4.3",
    "vitest": "^4.1.11"
  }
}
